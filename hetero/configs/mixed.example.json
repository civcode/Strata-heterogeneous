{
 "//": "Mixed split on Oberon, the counterpart of hiponly.example.json (the production setup): CUDA layers [0,15) (front stage, the CUDA build), HIP on the two R9700 (host, the HIP build; layer_split auto plans layers [15,48), report 0075). Pipelined windows as in production since report 0077: --pipeline-windows 2 with STRATA_PIPELINE_AUTO=0 and STRATA_MTP_STAGE0=0 (the draft layer on the host's last card); the front stage mirrors the host's first stage (its two verifiers, snapshots and undo). Start with hetero/tools/serve_mixed.py; placeholders: hetero/configs/README.md.",
 "exe": "${STRATA_REPO}/build-0083-hip/strata",
 "args": [
  "--pack",
  "${STRATA_DATA}/packs/q2_0",
  "--native",
  "${STRATA_MODEL_DIR}/Q2_0/Qwen3.8-Flash-Next-GSQ-RCO-Q2_0-00001-of-00002.gguf",
  "--ple-gguf",
  "${STRATA_MODEL_DIR}/Q2_0/Qwen3.8-Flash-Next-GSQ-RCO-Q2_0-00002-of-00002.gguf",
  "--expert-profile",
  "${STRATA_PROFILE}",
  "--expert-cache",
  "auto",
  "--mmap-experts",
  "--prefill",
  "auto",
  "--spec",
  "4",
  "--spec-min-p",
  "0.5",
  "--mtp",
  "${STRATA_DATA}/mtp/rt",
  "--max-context",
  "262144",
  "--kv",
  "int8",
  "--kv-resident",
  "0",
  "--vision",
  "--vram-reserve-mib",
  "700",
  "--control-vector-scaled",
  "${STRATA_VANILLA}/data/experimental-speed-projection/Qwen3.8-Flash-Next-experimental-speed-projection.gguf:1.0",
  "--control-vector-layer-range",
  "4",
  "44",
  "--cvec-mode",
  "project",
  "--cvec-dir",
  "per-layer",
  "--prompt-cache",
  "6",
  "--prompt-cache-spread",
  "--conversation-cache-slots",
  "4",
  "--conversation-cache-min-tokens",
  "8192",
  "--pipeline-windows",
  "2",
  "--front-exe",
  "${STRATA_REPO}/build-0083-cuda/strata",
  "--front-layers",
  "15"
 ],
 "cwd": "${STRATA_REPO}",
 "tokenizer": "${STRATA_DATA}/packs/q2_0/tokenizer",
 "model_name": "qwen3.8-flash-next-q2_0",
 "log": "${RUN_DIR}/server-mixed.log",
 "lib_dirs": [
  "${ROCM_LIB}"
 ],
 "port": 8091,
 "backend": "hip",
 "gpu": [
  0,
  1
 ],
 "gpus_asked": true,
 "layer_split": "auto",
 "vision": {
  "exe": "${STRATA_REPO}/build-0083-vision-hip/bin/strata-vision-hip",
  "mmproj": "${STRATA_MODEL_DIR}/mmproj-Qwen3.8-Flash-Next-BF16.gguf",
  "model": "${STRATA_MODEL_DIR}/Q2_0/Qwen3.8-Flash-Next-GSQ-RCO-Q2_0-00001-of-00002.gguf",
  "gpu": true,
  "max_tokens": 1024,
  "cpu_exe": "${STRATA_REPO}/build-0083-vision-cpu/bin/strata-vision"
 },
 "env": {
  "HSA_ENABLE_SDMA": "0",
  "STRATA_SPLIT_OVERLAP": "1",
  "STRATA_PIPELINE_AUTO": "0",
  "STRATA_MTP_STAGE0": "0"
 },
 "parallel": 1
}

{
 "//": "handoff 0075: hiponly.example.json, arm full",
 "exe": "${STRATA_REPO}/build-0071-hip/strata",
 "args": [
  "--pack",
  "${STRATA_DATA}/packs/q2_0",
  "--native",
  "${STRATA_MODEL_DIR}/Q2_0/Qwen3.8-Flash-Next-GSQ-RCO-Q2_0-00001-of-00002.gguf",
  "--ple-gguf",
  "${STRATA_MODEL_DIR}/Q2_0/Qwen3.8-Flash-Next-GSQ-RCO-Q2_0-00002-of-00002.gguf",
  "--expert-profile",
  "${STRATA_PROFILE}",
  "--expert-cache",
  "auto",
  "--prefill",
  "auto",
  "--spec",
  "4",
  "--spec-min-p",
  "0.5",
  "--mtp",
  "${STRATA_DATA}/mtp/rt",
  "--max-context",
  "196608",
  "--kv",
  "int8",
  "--vision",
  "--vram-reserve-mib",
  "700",
  "--control-vector-scaled",
  "${STRATA_VANILLA}/data/experimental-speed-projection/Qwen3.8-Flash-Next-experimental-speed-projection.gguf:1.0",
  "--control-vector-layer-range",
  "4",
  "44",
  "--cvec-mode",
  "project",
  "--cvec-dir",
  "per-layer"
 ],
 "cwd": "${STRATA_REPO}",
 "tokenizer": "${STRATA_DATA}/packs/q2_0/tokenizer",
 "model_name": "qwen3.8-flash-next-q2_0",
 "log": "${RUN_DIR}/server-hip.log",
 "lib_dirs": [
  "${ROCM_LIB}"
 ],
 "port": 8092,
 "backend": "hip",
 "gpu": [
  0,
  1
 ],
 "gpus_asked": true,
 "layer_split": "auto",
 "vision": {
  "exe": "${STRATA_REPO}/build-vision-hip/bin/strata-vision-hip",
  "mmproj": "${STRATA_MODEL_DIR}/mmproj-Qwen3.8-Flash-Next-BF16.gguf",
  "model": "${STRATA_MODEL_DIR}/Q2_0/Qwen3.8-Flash-Next-GSQ-RCO-Q2_0-00001-of-00002.gguf",
  "gpu": true,
  "max_tokens": 1024,
  "cpu_exe": "${STRATA_REPO}/build-vision-cpu/bin/strata-vision"
 }
}